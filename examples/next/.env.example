# Optional. With no key the example runs on a deterministic offline pattern
# matcher and says so in the UI. Set either one for a real model.
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Optional override, and a COMMA-SEPARATED LIST tried in order — because a
# pinned model id rots. This line used to suggest `llama-3.3-70b-versatile`,
# which Groq has since retired: it answers 404 model_not_found (checked live
# 2026-09-07), so anyone who uncommented it got a broken example. Leave it unset
# and the app uses a maintained default list.
# AI_FORMS_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
